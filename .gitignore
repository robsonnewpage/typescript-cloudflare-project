cloudflare-env.d.ts

# OpenNext
.open-next

# wrangler
.wrangler

# `wrangler r2 object get <key>` with no -o writes a file mirroring the
# key's path relative to cwd instead of under .wrangler/ — bit us once
# already (an empty meetings/m11/... turned up from an ad hoc debug
# command). Anchored to the repo root, not src/app/(app)/meetings/.
/meetings/
